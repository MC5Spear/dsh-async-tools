{
  "name": "dsh-async-tools",
  "version": "0.2.5+dsh.0.2.1-rc.2",
  "description": "Async execution plugin for DSH: `async_run` moves long commands to background jobs instead of killing them, `async_agent` delegates in the background, `async_wait_job` reads job results with a bounded wait, `async_wait_agent` bounds the wait on a subagent's running status while its final answer arrives as a separate message, `async_workflow` runs script orchestration as a background job, and every bounded wait returns early on user messages while background work keeps running.",
  "license": "MIT",
  "author": "MC5Spear (https://github.com/MC5Spear)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MC5Spear/dsh-async-tools.git"
  },
  "bugs": "https://github.com/MC5Spear/dsh-async-tools/issues",
  "homepage": "https://github.com/MC5Spear/dsh-async-tools#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import ./tools/_host-hooks.mjs --test \"test/*.test.mjs\"",
    "test:inproc": "node --import ./tools/_host-hooks.mjs --test --test-isolation=none \"test/*.test.mjs\"",
    "test:offline": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check-syntax.mjs",
    "check:preset": "node --import ./tools/_host-hooks.mjs tools/validate-preset.mjs",
    "check:public-surface": "node tools/check-public-surface.mjs",
    "check:encoding": "node tools/check-encoding.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:alias-tokens": "node tools/check-alias-tokens.mjs",
    "check:agent-policy": "node verify/check-agent-policy.mjs",
    "acceptance": "node verify/final-acceptance.mjs",
    "acceptance:e2e": "node verify/async-e2e.mjs",
    "acceptance:settings": "node verify/probe-settings-behavior-full.mjs",
    "probe:e2e": "node --import ./tools/_host-hooks.mjs tools/probe-e2e.mjs",
    "check:model-text": "node --import ./tools/_host-hooks.mjs tools/check-model-text.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/dsh-async.patch.yml",
        "./presets/dsh-async-create.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "async",
    "yield",
    "background-job",
    "subagent-wait"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "~4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-timer": "~1.1.7",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
